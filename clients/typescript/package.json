{
  "name": "@flexbit/sdk",
  "version": "1.0.4",
  "description": "FlexBIT SDK client for TypeScript/JavaScript",
  "keywords": [
    "api",
    "client",
    "energy",
    "flexbit",
    "rec"
  ],
  "license": "AGPL-3.0",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./module": {
      "types": "./dist/module-api.d.ts",
      "import": "./dist/module-api.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "sample:device": "cd sample && node --env-file=.env device-demo.ts",
    "sample:module": "cd sample && node --env-file=.env control-demo.ts",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test test/*.test.js"
  },
  "dependencies": {
    "@platformatic/kafka": "^2.13.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
